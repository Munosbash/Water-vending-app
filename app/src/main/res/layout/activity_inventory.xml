<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Inventory Control"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/stockOneLitreText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1L Bottles in stock: 0"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/stockTwoLitreText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="2L Bottles in stock: 0"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/quantityInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Quantity"
        android:inputType="number" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/addOneLitreButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Add 1L Stock" />

        <Button
            android:id="@+id/addTwoLitreButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Add 2L Stock" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/removeOneLitreButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Use/Spill 1L" />

        <Button
            android:id="@+id/removeTwoLitreButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Use/Spill 2L" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Activity Log:"
        android:textStyle="bold"
        android:layout_marginTop="20dp" />

    <ListView
        android:id="@+id/inventoryLogView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/goToDeliveryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Go to Delivery Log"
        android:layout_marginTop="12dp" />

</LinearLayout>