<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Manage Staff"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/newStaffUsername"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="New staff username"
        android:inputType="text" />

    <EditText
        android:id="@+id/newStaffPassword"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Password"
        android:inputType="textPassword" />

    <Button
        android:id="@+id/addStaffButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Staff" />

    <TextView
        android:id="@+id/staffMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#B00020"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Staff accounts (tap one to change its password):"
        android:textStyle="bold"
        android:layout_marginTop="12dp" />

    <ListView
        android:id="@+id/staffListView"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/selectedStaffText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selected: none"
        android:layout_marginTop="8dp" />

    <EditText
        android:id="@+id/changePasswordInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="New password"
        android:inputType="textPassword" />

       <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/changePasswordButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Change Password" />

        <Button
            android:id="@+id/deleteStaffButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Delete Staff"
            android:backgroundTint="#B00020" />
    </LinearLayout>

</LinearLayout>